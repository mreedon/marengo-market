---
import Layout from '../layouts/Layout.astro';

/* `music` is per-market on purpose: only the next market renders, so a lineup
   note retires itself when the date rolls over instead of going stale. */
const markets = [
  { date: 'Friday, May 29',      rainDate: 'June 5',      music: null },
  { date: 'Friday, June 26',     rainDate: null,          music: null },
  { date: 'Friday, August 7',    rainDate: null,          music: null },
  { date: 'Friday, August 28',   rainDate: 'September 4', music: { act: 'Two Girls One Guitar', time: '6:30–8 PM' } },
  { date: 'Friday, September 25', rainDate: 'October 2',  music: null },
];

const today = new Date();
today.setHours(0, 0, 0, 0);
const nextMarket = markets.find(m => {
  const d = new Date(m.date.replace('Friday, ', '') + ', 2026');
  return d >= today;
});
---

<Layout title="Home">
  <!-- Hero: poster -->
  <section class="px-4 pt-14 pb-12 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="eyebrow text-ink-soft text-sm rise">Calvin Spencer Park · Marengo, Illinois</p>
      <h1 class="font-display uppercase mt-4 rise" style="animation-delay: 0.08s">
        <span class="block text-barn leading-none text-[clamp(3rem,10vw,5.75rem)]">Marengo</span>
        <span class="block text-ink leading-tight text-[clamp(1.6rem,5.5vw,3.1rem)]">Makers Market</span>
      </h1>
      <p class="mt-4 text-lg text-ink-soft rise" style="animation-delay: 0.16s">
        handmade · homegrown · hometown
      </p>

      {nextMarket ? (
        <div class="mt-8 rise" style="animation-delay: 0.24s">
          <div class="ticket inline-block px-8 py-4 text-left">
            <p class="eyebrow text-[0.75rem] text-barn-deep">Next market</p>
            <p class="font-cond font-semibold uppercase tracking-wide text-2xl md:text-3xl leading-tight">
              {nextMarket.date} · 5–8 PM
            </p>
            {nextMarket.music && (
              <p class="text-sm text-ink/80 mt-1.5">
                <span class="eyebrow text-barn-deep text-[0.7rem]">Live music</span>
                {' '}{nextMarket.music.act} · {nextMarket.music.time}
              </p>
            )}
            {nextMarket.rainDate && (
              <p class="text-sm text-ink/70 mt-0.5">Rain date: {nextMarket.rainDate}</p>
            )}
          </div>
        </div>
      ) : (
        <p class="mt-8 text-lg text-ink-soft rise" style="animation-delay: 0.24s">
          That's a wrap on the 2026 season. See you next May!
        </p>
      )}

      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center rise" style="animation-delay: 0.32s">
        <a href="/vendors" class="btn-punch">See the vendors</a>
        <a href="/schedule" class="btn-quiet">Full schedule</a>
      </div>
    </div>
  </section>

  <!-- Detail cards -->
  <section class="max-w-5xl mx-auto px-4 py-14 grid md:grid-cols-3 gap-6">
    <div class="bg-paper-bright rounded-lg p-6 border border-line">
      <svg class="w-8 h-8 mb-3" viewBox="0 0 24 24" fill="none" stroke="#7c2214" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10z" />
        <circle cx="12" cy="11" r="2.2" />
      </svg>
      <h2 class="eyebrow text-barn text-sm mb-2">Location</h2>
      <p class="text-ink text-sm leading-relaxed">
        <strong>Calvin Spencer Park</strong><br />
        351 Hale St., Marengo, IL<br />
        <span class="text-ink-soft">Across from the Catholic Church</span>
      </p>
      <a href="https://maps.google.com/?q=351+Hale+St+Marengo+IL" target="_blank" rel="noopener"
        class="inline-block mt-3 text-sm font-bold text-barn hover:underline underline-offset-4">
        Get directions →
      </a>
    </div>

    <div class="bg-paper-bright rounded-lg p-6 border border-line">
      <svg class="w-8 h-8 mb-3" viewBox="0 0 24 24" fill="none" stroke="#7c2214" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3.2 2" />
      </svg>
      <h2 class="eyebrow text-barn text-sm mb-2">Hours</h2>
      <p class="text-ink text-sm leading-relaxed">
        <strong>5:00 PM – 8:00 PM</strong><br />
        Monthly on Fridays<br />
        <span class="text-ink-soft">May through September 2026</span>
      </p>
    </div>

    <div class="bg-paper-bright rounded-lg p-6 border border-line">
      <svg class="w-8 h-8 mb-3" viewBox="0 0 24 24" fill="none" stroke="#7c2214" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 10l9-6.5L21 10" />
        <path d="M3 10c1.5 2.2 3 2.2 4.5 0c1.5 2.2 3 2.2 4.5 0c1.5 2.2 3 2.2 4.5 0c1.5 2.2 3 2.2 4.5 0" />
        <path d="M5.5 12.5V20M18.5 12.5V20" />
      </svg>
      <h2 class="eyebrow text-barn text-sm mb-2">Vendors</h2>
      <p class="text-ink text-sm leading-relaxed">
        A wide variety of crafters, local vendors, and farmers. Interested in a booth?
      </p>
      <a href="/contact" class="inline-block mt-3 text-sm font-bold text-barn hover:underline underline-offset-4">
        Request a booth →
      </a>
    </div>
  </section>

  <!-- 2026 schedule preview -->
  <section class="py-14 px-4 bg-paper-deep">
    <div class="max-w-3xl mx-auto">
      <p class="eyebrow text-ink-soft text-sm text-center">2026 Season</p>
      <h2 class="font-display text-3xl text-barn text-center mt-1 mb-8">Market Dates</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm bg-paper-bright rounded-lg overflow-hidden border border-line">
          <thead>
            <tr class="bg-barn text-paper">
              <th class="eyebrow px-5 py-3 text-left text-[0.85rem] font-semibold">Market Date</th>
              <th class="eyebrow px-5 py-3 text-left text-[0.85rem] font-semibold">Rain Date</th>
            </tr>
          </thead>
          <tbody>
            {markets.map((m, i) => (
              <tr class:list={[m === nextMarket ? 'bg-gold/25' : i % 2 !== 0 ? 'bg-paper' : '']}>
                <td class="px-5 py-3 font-bold">
                  {m.date}
                  {m === nextMarket && (
                    <span class="eyebrow bg-gold text-ink text-[0.65rem] rounded px-1.5 py-0.5 ml-2 align-middle">Next</span>
                  )}
                </td>
                <td class="px-5 py-3 text-ink-soft">{m.rainDate ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-center mt-4 text-sm text-ink-soft">All markets run 5:00–8:00 PM at Calvin Spencer Park</p>
    </div>
  </section>

  <!-- Facebook CTA -->
  <section class="max-w-3xl mx-auto px-4 py-14 text-center">
    <h2 class="font-display text-2xl text-barn mb-3">Stay Connected</h2>
    <p class="text-ink-soft mb-6">Follow us on Facebook for updates, vendor spotlights, and rain-day announcements.</p>
    <a href="https://www.facebook.com/groups/marengoilmarket" target="_blank" rel="noopener"
      class="inline-flex items-center gap-2 bg-dusk text-paper font-bold px-6 py-3 rounded-lg hover:bg-dusk-deep transition-colors">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.884v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
      </svg>
      Join us on Facebook
    </a>
  </section>
</Layout>
