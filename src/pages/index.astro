---
import Layout from '../layouts/Layout.astro';

const markets = [
  { date: 'Friday, May 29',      rainDate: 'June 5' },
  { date: 'Friday, June 26',     rainDate: null },
  { date: 'Friday, July 31',     rainDate: 'August 7' },
  { date: 'Friday, August 28',   rainDate: 'September 4' },
  { date: 'Friday, September 25', rainDate: 'October 2' },
];

const today = new Date();
const nextMarket = markets.find(m => {
  const d = new Date(m.date.replace('Friday, ', '') + ', 2026');
  return d >= today;
});
---

<Layout title="Home">
  <!-- Hero -->
  <section class="text-white py-20 px-4" style="background: linear-gradient(135deg, var(--primary), var(--primary-hover))">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-sm font-semibold uppercase tracking-widest mb-3" style="color: var(--primary-muted)">Marengo, Illinois</p>
      <h1 class="text-4xl md:text-6xl font-bold mb-4 leading-tight">Marengo Makers Market</h1>
      <p class="text-lg md:text-xl mb-8 max-w-xl mx-auto" style="color: var(--primary-light)">
        Crafters, farmers, and local vendors — monthly Friday evenings at Calvin Spencer Park.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/schedule"
          class="font-semibold px-6 py-3 rounded-lg transition-colors"
          style="background: var(--accent); color: var(--accent-text)"
          onmouseover="this.style.background='var(--accent-hover)'"
          onmouseout="this.style.background='var(--accent)'">
          View Full Schedule
        </a>
        <a href="/vendors"
          class="border border-white text-white font-semibold px-6 py-3 rounded-lg transition-colors hover:bg-white"
          onmouseover="this.style.color='var(--primary)'"
          onmouseout="this.style.color='white'">
          See Vendors
        </a>
      </div>
    </div>
  </section>

  <!-- Next Market Banner -->
  {nextMarket && (
    <section class="py-5 px-4" style="background: var(--accent)">
      <div class="max-w-3xl mx-auto text-center">
        <p class="font-semibold text-lg" style="color: var(--accent-text)">
          🗓 Next market: <strong>{nextMarket.date}</strong> &nbsp;·&nbsp; 5:00–8:00 PM
          {nextMarket.rainDate && (
            <span class="text-sm font-normal ml-2">(Rain date: {nextMarket.rainDate})</span>
          )}
        </p>
      </div>
    </section>
  )}

  <!-- Featured: Florence Nursing Home Donation Drive -->
  <section class="py-12 px-4" style="background: var(--muted-bg)">
    <div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-sm overflow-hidden" style="border: 1px solid var(--border-c)">
      <div class="px-6 py-4 text-white" style="background: linear-gradient(135deg, var(--primary), var(--primary-hover))">
        <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: var(--primary-muted)">July 31 — Donation Drive</p>
        <h2 class="text-2xl font-bold">💝 Florence Nursing Home — Bingo Prize Wish List</h2>
        <p class="text-sm mt-1" style="color: var(--primary-light)">Help bring smiles to the residents!</p>
      </div>
      <div class="px-6 py-6 md:flex md:gap-6 md:items-start">
        <img src="/images/florence-wish-list.jpg" alt="Florence Nursing Home wish list flyer for bingo prizes, decorated with bingo cards and balls, listing the donation items below"
          class="w-full md:w-2/5 rounded-xl mb-5 md:mb-0" loading="lazy" width="1080" height="1620" />
        <div class="md:flex-1">
          <p class="text-gray-700 leading-relaxed mb-6">
            Florence Nursing Home is collecting bingo prizes for its residents —
            bring your donations to the <strong>July 31 market</strong> and we'll get
            them to the home. Donations of the following items are greatly appreciated:
          </p>

          <ul class="grid grid-cols-2 gap-x-6 gap-y-1 text-sm text-gray-700 mb-6">
            <li>Word Searches</li>
            <li>Deodorant</li>
            <li>Shampoo</li>
            <li>Conditioner</li>
            <li>Body Wash</li>
            <li>Toothpaste &amp; Toothbrushes</li>
            <li>Candy &amp; Snacks (incl. sugar-free)</li>
            <li>Earrings</li>
            <li>Rings</li>
            <li>Ankle Socks for Men &amp; Women</li>
            <li>Non-Slip Socks</li>
            <li>Stamps</li>
            <li>Hair Accessories</li>
            <li>Perfume / Cologne</li>
            <li>Holiday / Seasonal Décor</li>
            <li>Crafts for Door Decorations</li>
          </ul>

          <p class="text-sm text-gray-600">
            Thank you for supporting the residents of Florence Nursing Home! 💜
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detail Cards -->
  <section class="max-w-5xl mx-auto px-4 py-16 grid md:grid-cols-3 gap-8">
    <div class="bg-white rounded-2xl p-6 shadow-sm" style="border: 1px solid var(--border-c)">
      <div class="text-3xl mb-3">📍</div>
      <h2 class="font-bold text-lg mb-2" style="color: var(--primary)">Location</h2>
      <p class="text-gray-700 text-sm leading-relaxed">
        <strong>Calvin Spencer Park</strong><br />
        351 Hale St., Marengo, IL<br />
        <span class="text-gray-500">Across from the Catholic Church</span>
      </p>
      <a href="https://maps.google.com/?q=351+Hale+St+Marengo+IL" target="_blank" rel="noopener"
        class="inline-block mt-3 text-sm font-medium hover:underline" style="color: var(--link)">
        Get directions →
      </a>
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-sm" style="border: 1px solid var(--border-c)">
      <div class="text-3xl mb-3">🕔</div>
      <h2 class="font-bold text-lg mb-2" style="color: var(--primary)">Hours</h2>
      <p class="text-gray-700 text-sm leading-relaxed">
        <strong>5:00 PM – 8:00 PM</strong><br />
        Monthly on Fridays<br />
        <span class="text-gray-500">May through September 2026</span>
      </p>
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-sm" style="border: 1px solid var(--border-c)">
      <div class="text-3xl mb-3">🛖</div>
      <h2 class="font-bold text-lg mb-2" style="color: var(--primary)">Vendors</h2>
      <p class="text-gray-700 text-sm leading-relaxed">
        Wide variety of crafters, local vendors, and farmers. Interested in a booth?
      </p>
      <a href="/contact" class="inline-block mt-3 text-sm font-medium hover:underline" style="color: var(--link)">
        Request a booth →
      </a>
    </div>
  </section>

  <!-- 2026 Schedule Preview -->
  <section class="py-14 px-4" style="background: var(--muted-bg)">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold text-center mb-8" style="color: var(--primary)">2026 Market Dates</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm bg-white rounded-xl shadow-sm" style="border: 1px solid var(--border-c)">
          <thead>
            <tr class="text-white" style="background: var(--primary)">
              <th class="px-5 py-3 text-left font-semibold rounded-tl-xl">Market Date</th>
              <th class="px-5 py-3 text-left font-semibold rounded-tr-xl">Rain Date</th>
            </tr>
          </thead>
          <tbody>
            {markets.map((m, i) => (
              <tr style={i % 2 !== 0 ? 'background: var(--row-alt)' : ''}>
                <td class="px-5 py-3 font-medium">{m.date}</td>
                <td class="px-5 py-3 text-gray-500">{m.rainDate ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-center mt-4 text-sm text-gray-500">All markets run 5:00–8:00 PM at Calvin Spencer Park</p>
    </div>
  </section>

  <!-- Facebook CTA -->
  <section class="max-w-3xl mx-auto px-4 py-14 text-center">
    <h2 class="text-2xl font-bold mb-3" style="color: var(--primary)">Stay Connected</h2>
    <p class="text-gray-600 mb-6">Follow us on Facebook for updates, vendor spotlights, and rain-day announcements.</p>
    <a href="https://www.facebook.com/groups/marengoilmarket" target="_blank" rel="noopener"
      class="inline-flex items-center gap-2 bg-[#1877f2] text-white font-semibold px-6 py-3 rounded-lg hover:bg-[#1465d8] transition-colors">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.884v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
      </svg>
      Join us on Facebook
    </a>
  </section>
</Layout>
