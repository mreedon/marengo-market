---

<Layout title="Vendors" description="Meet the vendors at the Marengo Makers Market — crafters, farmers, and local makers.">
  <section class="max-w-4xl mx-auto px-4 py-14">
    <h1 class="text-3xl font-bold mb-2" style="color: var(--primary)">Vendors</h1>
    <p class="text-gray-600 mb-2">Lineup for <strong>Friday, June 26, 2026</strong> — 5:00–8:00 PM · Calvin Spencer Park</p>
    <p class="text-sm text-gray-500 mb-8">
      Vendor lists are updated per market date. Follow
      <a href="https://www.facebook.com/groups/marengoilmarket" target="_blank" rel="noopener"
        class="font-medium hover:underline" style="color: var(--link)">Facebook</a>
      for the latest additions.
    </p>

    <div class="grid sm:grid-cols-2 gap-4">
      {vendors.map(v => (
        <div class="bg-white rounded-xl p-4 shadow-sm" style="border: 1px solid var(--border-c)">
          <p class="font-semibold text-[#1a1a1a] text-sm">{v.name}</p>
          {v.items && <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">{v.items}</p>}
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <p class="text-sm text-gray-600 mb-3">Interested in a booth at a future market?</p>
      <a href="/contact"
        class="inline-block text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors"
        style="background: var(--primary)"
        onmouseover="this.style.background='var(--primary-hover)'"
        onmouseout="this.style.background='var(--primary)'">
        Contact Us
      </a>
    </div>
  </section>
</Layout>
