---

<Layout title="Vendors" description="Meet the vendors at the Marengo Makers Market: crafters, farmers, and local makers.">
  <section class="max-w-5xl mx-auto px-4 py-14">
    <p class="eyebrow text-ink-soft text-sm">Friday, August 28, 2026 · 5–8 PM · Calvin Spencer Park</p>
    <h1 class="font-display text-4xl text-barn mt-1 mb-3">Vendors</h1>
    <p class="text-sm text-ink-soft mb-8 max-w-xl">
      <span class="eyebrow bg-kraft border border-line rounded px-2 py-0.5 text-[0.75rem] text-ink mr-2">{vendors.length} booths this market</span>
      Booth numbers follow the organizer's park layout. Lineups change each market date. Follow
      <a href="https://www.facebook.com/groups/marengoilmarket" target="_blank" rel="noopener"
        class="font-bold text-barn hover:underline underline-offset-4">Facebook</a>
      for any day-of updates.
    </p>

    {/* Food & drink menus */}
    <div class="mb-10">
      <h2 class="eyebrow text-barn text-sm">Come hungry</h2>
      <p class="font-display text-2xl text-ink mt-1 mb-4">This market's menus</p>
      <div class="grid sm:grid-cols-2 gap-6 max-w-2xl">
        {vendors.filter(v => v.menu).map((v, i) => (
          <a
            href={v.menu}
            target="_blank"
            rel="noopener"
            class={`block bg-white border-2 border-line rounded p-2 pb-3 shadow-sm transition-transform hover:rotate-0 motion-reduce:transform-none ${i % 2 ? 'rotate-1' : '-rotate-1'}`}
          >
            <img src={v.menu} alt={`${v.name} menu`} class="w-full h-auto rounded-sm" loading="lazy" />
            <p class="eyebrow text-ink text-[0.7rem] text-center mt-2">{v.name} · tap for full size</p>
          </a>
        ))}
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {vendors.map(v => (
        <div class="tag p-4 pl-7">
          <div class="flex items-start justify-between gap-2">
            <p class="font-bold text-ink text-sm">{v.name}</p>
            <span class="eyebrow shrink-0 bg-paper border border-line rounded-sm px-1.5 py-0.5 text-[0.65rem] text-ink-soft whitespace-nowrap">{v.booth}</span>
          </div>
          {v.items && <p class="text-xs text-ink-soft mt-0.5 leading-relaxed">{v.items}</p>}
          {v.menu && (
            <a href={v.menu} target="_blank" rel="noopener" class="inline-block text-xs font-bold text-barn hover:underline underline-offset-4 mt-1.5">
              View menu &rarr;
            </a>
          )}
        </div>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-sm text-ink-soft mb-4">Interested in a booth at a future market? Booth fees are $5 per market date, collected the day of the event.</p>
      <a href="/contact" class="btn-punch text-sm">Request a booth</a>
    </div>
  </section>
</Layout>
