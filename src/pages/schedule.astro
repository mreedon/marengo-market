---
import Layout from '../layouts/Layout.astro';

/* Keep `music` in step with the same field on the homepage when a lineup lands. */
const markets = [
  { date: 'Friday, May 29',       rainDate: 'Friday, June 5',       music: null },
  { date: 'Friday, June 26',      rainDate: null,                   music: null },
  { date: 'Friday, August 7',     rainDate: null,                   music: null },
  { date: 'Friday, August 28',    rainDate: 'Friday, September 4',  music: 'Two Girls One Guitar, 6:30–8 PM' },
  { date: 'Friday, September 25', rainDate: 'Friday, October 2',    music: null },
];

const today = new Date();
today.setHours(0, 0, 0, 0);
const nextMarket = markets.find(m => {
  const d = new Date(m.date.replace('Friday, ', '') + ', 2026');
  return d >= today;
});
---

<Layout title="Schedule" description="2026 Marengo Makers Market schedule: monthly Fridays at Calvin Spencer Park, 5-8 PM.">
  <section class="max-w-3xl mx-auto px-4 py-14">
    <p class="eyebrow text-ink-soft text-sm">2026 Season</p>
    <h1 class="font-display text-4xl text-barn mt-1 mb-3">Market Schedule</h1>
    <p class="text-ink-soft mb-8">Monthly Friday evenings, 5:00–8:00 PM · Calvin Spencer Park, 351 Hale St., Marengo</p>

    <div class="overflow-x-auto mb-8">
      <table class="w-full text-sm bg-paper-bright rounded-lg overflow-hidden border border-line">
        <thead>
          <tr class="bg-barn text-paper">
            <th class="eyebrow px-5 py-3 text-left text-[0.85rem] font-semibold">Market Date</th>
            <th class="eyebrow px-5 py-3 text-left text-[0.85rem] font-semibold">Time</th>
            <th class="eyebrow px-5 py-3 text-left text-[0.85rem] font-semibold">Rain Date</th>
          </tr>
        </thead>
        <tbody>
          {markets.map((m, i) => (
            <tr class:list={[m === nextMarket ? 'bg-gold/25' : i % 2 !== 0 ? 'bg-paper' : '']}>
              <td class="px-5 py-3 font-bold">
                {m.date}
                {m === nextMarket && (
                  <span class="eyebrow bg-gold text-ink text-[0.65rem] rounded px-1.5 py-0.5 ml-2 align-middle">Next</span>
                )}
                {m.music && (
                  <span class="block font-normal text-ink-soft text-xs mt-0.5">Live music: {m.music}</span>
                )}
              </td>
              <td class="px-5 py-3 text-ink-soft">5:00–8:00 PM</td>
              <td class="px-5 py-3 text-ink-soft">{m.rainDate ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="bg-kraft border border-line rounded-lg p-5 text-sm text-ink">
      <p class="eyebrow text-barn text-xs mb-1.5">Rain policy</p>
      <p>In the event of rain, the market moves to its listed rain date. Follow us on
        <a href="https://www.facebook.com/groups/marengoilmarket" target="_blank" rel="noopener"
          class="font-bold text-barn hover:underline underline-offset-4">Facebook</a>
        for same-day updates.
      </p>
    </div>

    <div class="mt-10 bg-paper-bright rounded-lg p-6 border border-line">
      <h2 class="eyebrow text-barn text-sm mb-3">Getting here</h2>
      <p class="text-sm text-ink mb-1"><strong>Calvin Spencer Park</strong></p>
      <p class="text-sm text-ink-soft mb-4">351 Hale St., Marengo, IL · Across from the Catholic Church</p>
      <a href="https://maps.google.com/?q=351+Hale+St+Marengo+IL" target="_blank" rel="noopener"
        class="text-sm font-bold text-barn hover:underline underline-offset-4">
        Open in Google Maps →
      </a>
    </div>
  </section>
</Layout>
