---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Contact the Marengo Makers Market — vendor booth inquiries, general questions, and social media.">
  <section class="max-w-2xl mx-auto px-4 py-14">
    <h1 class="text-3xl font-bold mb-3" style="color: var(--primary)">Contact Us</h1>
    <p class="text-gray-600 mb-10">Questions or interested in a booth? Reach out — we'd love to have you.</p>

    <div class="space-y-6">
      <div class="bg-white rounded-xl p-6 shadow-sm flex gap-4 items-start" style="border: 1px solid var(--border-c)">
        <div class="text-3xl">✉️</div>
        <div>
          <h2 class="font-bold mb-1" style="color: var(--primary)">Email</h2>
          <p class="text-sm text-gray-600 mb-2">For booth inquiries or general questions:</p>
          <a href="mailto:Marengoilmarket@gmail.com" class="font-medium hover:underline" style="color: var(--link)">
            Marengoilmarket@gmail.com
          </a>
        </div>
      </div>

      <div class="bg-white rounded-xl p-6 shadow-sm flex gap-4 items-start" style="border: 1px solid var(--border-c)">
        <div class="text-3xl">📘</div>
        <div>
          <h2 class="font-bold mb-1" style="color: var(--primary)">Facebook Group</h2>
          <p class="text-sm text-gray-600 mb-2">Follow for updates, vendor news, and rain-day announcements:</p>
          <a href="https://www.facebook.com/groups/marengoilmarket" target="_blank" rel="noopener"
            class="font-medium hover:underline" style="color: var(--link)">
            facebook.com/groups/marengoilmarket
          </a>
        </div>
      </div>

      <div class="rounded-xl p-6" style="background: var(--muted-bg); border: 1px solid var(--border-c)">
        <h2 class="font-bold mb-2" style="color: var(--primary)">Vendor Booths</h2>
        <p class="text-sm text-gray-700 leading-relaxed">
          We welcome a wide variety of crafters, farmers, and local vendors. If you're interested in reserving a booth for an upcoming market date, email us at
          <a href="mailto:Marengoilmarket@gmail.com" class="font-medium hover:underline" style="color: var(--link)">Marengoilmarket@gmail.com</a>
          with your name, what you sell, and which date(s) you'd like to participate.
        </p>
        <p class="text-sm text-gray-700 leading-relaxed mt-3">
          To sign up, fill out the two forms below and return them to us:
        </p>
        <div class="flex flex-wrap gap-3 mt-3">
          <a href="/forms/vendor-application.pdf" target="_blank" rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium text-white hover:opacity-90"
            style="background: var(--primary)">
            📄 Vendor Application
          </a>
          <a href="/forms/hold-harmless-agreement.pdf" target="_blank" rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium hover:underline"
            style="color: var(--link); border: 1px solid var(--border-c); background: white">
            📄 Hold Harmless Agreement
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
