---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Contact the Marengo Makers Market — vendor booth inquiries, general questions, and social media.">
  <section class="max-w-2xl mx-auto px-4 py-14">
    <h1 class="text-3xl font-bold text-[#1e5631] mb-3">Contact Us</h1>
    <p class="text-gray-600 mb-10">Questions or interested in a booth? Reach out — we'd love to have you.</p>

    <div class="space-y-6">
      <!-- Email -->
      <div class="bg-white rounded-xl border border-[#e0ead8] p-6 shadow-sm flex gap-4 items-start">
        <div class="text-3xl">✉️</div>
        <div>
          <h2 class="font-bold text-[#1e5631] mb-1">Email</h2>
          <p class="text-sm text-gray-600 mb-2">For booth inquiries or general questions:</p>
          <a href="mailto:Marengoilmarket@gmail.com" class="text-[#2d6a4f] font-medium hover:underline">
            Marengoilmarket@gmail.com
          </a>
        </div>
      </div>

      <!-- Facebook -->
      <div class="bg-white rounded-xl border border-[#e0ead8] p-6 shadow-sm flex gap-4 items-start">
        <div class="text-3xl">📘</div>
        <div>
          <h2 class="font-bold text-[#1e5631] mb-1">Facebook Group</h2>
          <p class="text-sm text-gray-600 mb-2">Follow for updates, vendor news, and rain-day announcements:</p>
          <a
            href="https://www.facebook.com/groups/marengoilmarket"
            target="_blank"
            rel="noopener"
            class="text-[#2d6a4f] font-medium hover:underline"
          >
            facebook.com/groups/marengoilmarket
          </a>
        </div>
      </div>

      <!-- Vendor info -->
      <div class="bg-[#f0f7f2] rounded-xl border border-[#c8e6c9] p-6">
        <h2 class="font-bold text-[#1e5631] mb-2">Vendor Booths</h2>
        <p class="text-sm text-gray-700 leading-relaxed">
          We welcome a wide variety of crafters, farmers, and local vendors. If you're interested in reserving a booth for an upcoming market date, email us at <a href="mailto:Marengoilmarket@gmail.com" class="text-[#2d6a4f] font-medium hover:underline">Marengoilmarket@gmail.com</a> with your name, what you sell, and which date(s) you'd like to participate.
        </p>
      </div>
    </div>
  </section>
</Layout>
