---
// Pennant bunting — the site signature, hung below the nav on every page.
---
<svg class="block w-full" height="16" aria-hidden="true">
  <defs>
    <pattern id="bunting" width="72" height="16" patternUnits="userSpaceOnUse">
      <polygon points="2,0 22,0 12,13" fill="#7c2214" />
      <polygon points="26,0 46,0 36,13" fill="#e8ae35" />
      <polygon points="50,0 70,0 60,13" fill="#24374a" />
    </pattern>
  </defs>
  <rect width="100%" height="16" fill="url(#bunting)" />
  <rect width="100%" height="1" fill="#2c241f" opacity="0.3" />
</svg>
