---
const presets = [
  { name: 'Rustic',   primary: '#8b3a1e', accent: '#7a9a6a' },
  { name: 'Forest',   primary: '#1e5631', accent: '#e9c46a' },
  { name: 'Cobalt',   primary: '#1a3a5c', accent: '#f0b429' },
  { name: 'Harvest',  primary: '#4a1c5c', accent: '#e8604c' },
  { name: 'Slate',    primary: '#334155', accent: '#f97316' },
  { name: 'Pine',     primary: '#1a3a2a', accent: '#c4a76b' },
];
---

<div id="theme-picker" class="fixed bottom-5 right-5 z-50 select-none">
  <!-- Toggle button -->
  <button id="theme-toggle"
    class="flex items-center gap-2 bg-white border border-gray-200 shadow-lg rounded-full px-4 py-2 text-sm font-medium text-gray-700 hover:shadow-xl transition-all"
    aria-label="Customize site colors">
    <span>🎨</span>
    <span>Customize</span>
  </button>

  <!-- Panel -->
  <div id="theme-panel"
    class="hidden absolute bottom-12 right-0 bg-white rounded-2xl shadow-2xl border border-gray-100 p-5 w-56">

    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4">Site colors</p>

    <!-- Primary picker -->
    <div class="flex items-center gap-3 mb-3">
      <label class="text-xs text-gray-500 w-12 shrink-0">Primary</label>
      <div class="relative w-8 h-8 shrink-0">
        <div id="primary-swatch" class="absolute inset-0 rounded-full shadow border-2 border-white pointer-events-none"></div>
        <input type="color" id="primary-input"
          class="absolute inset-0 opacity-0 cursor-pointer w-full h-full rounded-full" />
      </div>
      <span id="primary-hex" class="text-xs text-gray-400 font-mono"></span>
    </div>

    <!-- Accent picker -->
    <div class="flex items-center gap-3 mb-5">
      <label class="text-xs text-gray-500 w-12 shrink-0">Accent</label>
      <div class="relative w-8 h-8 shrink-0">
        <div id="accent-swatch" class="absolute inset-0 rounded-full shadow border-2 border-white pointer-events-none"></div>
        <input type="color" id="accent-input"
          class="absolute inset-0 opacity-0 cursor-pointer w-full h-full rounded-full" />
      </div>
      <span id="accent-hex" class="text-xs text-gray-400 font-mono"></span>
    </div>

    <!-- Presets -->
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Presets</p>
    <div class="grid grid-cols-3 gap-2">
      {presets.map(pr => (
        <button
          class="preset-btn flex flex-col items-center gap-1 p-2 rounded-xl hover:bg-gray-50 transition-colors"
          data-primary={pr.primary}
          data-accent={pr.accent}
          title={pr.name}
        >
          <div class="flex gap-0.5">
            <span class="w-4 h-4 rounded-full shadow-sm" style={`background:${pr.primary}`}></span>
            <span class="w-4 h-4 rounded-full shadow-sm" style={`background:${pr.accent}`}></span>
          </div>
          <span class="text-[10px] text-gray-500 leading-none">{pr.name}</span>
        </button>
      ))}
    </div>

    <p class="text-[10px] text-gray-400 text-center mt-4">Saves automatically</p>
  </div>
</div>

<script>
  const STORAGE = { p: 'mmm-primary', a: 'mmm-accent' };
  const DEFAULT = { p: '#8b3a1e', a: '#7a9a6a' };

  function luminance(hex: string) {
    const c = [1,3,5].map(i => parseInt(hex.slice(i,i+2),16)/255);
    const lin = (v: number) => v <= 0.03928 ? v/12.92 : Math.pow((v+0.055)/1.055, 2.4);
    return 0.2126*lin(c[0]) + 0.7152*lin(c[1]) + 0.0722*lin(c[2]);
  }

  function applyColors(primary: string, accent: string) {
    const el = document.documentElement;
    el.style.setProperty('--primary', primary);
    el.style.setProperty('--accent',  accent);
    el.style.setProperty('--accent-text', luminance(accent) > 0.35 ? '#1a1a1a' : '#ffffff');
    try {
      localStorage.setItem(STORAGE.p, primary);
      localStorage.setItem(STORAGE.a, accent);
    } catch(e) {}

    // Sync picker UI
    const ps = document.getElementById('primary-swatch') as HTMLElement;
    const as = document.getElementById('accent-swatch')  as HTMLElement;
    const pi = document.getElementById('primary-input')  as HTMLInputElement;
    const ai = document.getElementById('accent-input')   as HTMLInputElement;
    const ph = document.getElementById('primary-hex')    as HTMLElement;
    const ah = document.getElementById('accent-hex')     as HTMLElement;
    if (ps) ps.style.background = primary;
    if (as) as.style.background = accent;
    if (pi) pi.value = primary;
    if (ai) ai.value = accent;
    if (ph) ph.textContent = primary;
    if (ah) ah.textContent = accent;
  }

  // Init
  const savedP = (() => { try { return localStorage.getItem(STORAGE.p) || DEFAULT.p; } catch(e) { return DEFAULT.p; } })();
  const savedA = (() => { try { return localStorage.getItem(STORAGE.a) || DEFAULT.a; } catch(e) { return DEFAULT.a; } })();
  applyColors(savedP, savedA);

  // Toggle panel
  document.getElementById('theme-toggle')?.addEventListener('click', e => {
    e.stopPropagation();
    document.getElementById('theme-panel')?.classList.toggle('hidden');
  });

  // Close on outside click
  document.addEventListener('click', e => {
    const picker = document.getElementById('theme-picker');
    if (!picker?.contains(e.target as Node)) {
      document.getElementById('theme-panel')?.classList.add('hidden');
    }
  });

  // Live update from color inputs
  function currentColors() {
    const p = (document.getElementById('primary-input') as HTMLInputElement)?.value || savedP;
    const a = (document.getElementById('accent-input')  as HTMLInputElement)?.value || savedA;
    return { p, a };
  }
  document.getElementById('primary-input')?.addEventListener('input', () => {
    const { p, a } = currentColors();
    applyColors(p, a);
  });
  document.getElementById('accent-input')?.addEventListener('input', () => {
    const { p, a } = currentColors();
    applyColors(p, a);
  });

  // Presets
  document.querySelectorAll<HTMLElement>('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      applyColors(btn.dataset.primary!, btn.dataset.accent!);
    });
  });
</script>
