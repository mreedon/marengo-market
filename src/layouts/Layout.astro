---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ThemePicker from '../components/ThemePicker.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Crafters, vendors, and farmers — monthly Friday evenings at Calvin Spencer Park in Marengo, IL.' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Marengo Makers Market</title>
    <!-- Apply saved theme before paint to avoid flash -->
    <script is:inline>
      (function() {
        try {
          const t = localStorage.getItem('mmm-theme') || 'forest';
          document.documentElement.dataset.theme = t;
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="bg-[var(--page-bg)] text-[#1a1a1a] font-sans min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <ThemePicker />
  </body>
</html>
