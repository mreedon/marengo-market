---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ThemePicker from '../components/ThemePicker.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Crafters, vendors, and farmers — monthly Friday evenings at Calvin Spencer Park in Marengo, IL.' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Marengo Makers Market</title>
    <!-- Restore saved colors before paint to avoid flash -->
    <script is:inline>
      (function() {
        try {
          var p = localStorage.getItem('mmm-primary') || '#8b3a1e';
          var a = localStorage.getItem('mmm-accent')  || '#7a9a6a';
          var el = document.documentElement;
          el.style.setProperty('--primary', p);
          el.style.setProperty('--accent',  a);
          // Set accent-text based on luminance so text is readable on any accent bg
          function lum(hex) {
            var c = [1,3,5].map(function(i){ return parseInt(hex.slice(i,i+2),16)/255; });
            c = c.map(function(v){ return v<=0.03928 ? v/12.92 : Math.pow((v+0.055)/1.055,2.4); });
            return 0.2126*c[0] + 0.7152*c[1] + 0.0722*c[2];
          }
          el.style.setProperty('--accent-text', lum(a) > 0.35 ? '#1a1a1a' : '#ffffff');
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="bg-[var(--page-bg)] text-[#1a1a1a] font-sans min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <ThemePicker />
  </body>
</html>
